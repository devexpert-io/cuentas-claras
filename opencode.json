{
  "$schema": "https://opencode.ai/config.json",
  "model": "devexpert/chat",
  "providers": {
    "devexpert": {
      "name": "DevExpert",
      "package": "@opencode/ai/providers/openai-compatible",
      "env": ["DEVEXPERT_API_KEY"],
      "settings": { "baseURL": "https://inference.devexpert.io/v1" },
      "models": {
        "chat": {
          "name": "DevExpert Chat",
          "capabilities": { "tools": true, "reasoning": { "supported": true } },
          "cost": { "input": 0.3, "output": 1.2, "cache": { "read": 0.006 } },
          "limit": { "context": 1048576, "output": 943718 }
        }
      }
    }
  }
}
